---
interface Props {
	eyebrow: string;
	title: string;
	intro?: string;
	image?: string;
	imageAlt?: string;
}
const { eyebrow, title, intro, image, imageAlt = '' } = Astro.props;
---

<section class="page-hero section--dark topo" class:list={{ 'has-image': !!image }}>
	<div class="container page-hero__inner">
		<div class="page-hero__text">
			<span class="eyebrow">{eyebrow}</span>
			<h1 set:html={title} />
			{intro && <p class="lede">{intro}</p>}
			<slot />
		</div>
		{
			image && (
				<div class="page-hero__img frame">
					<img src={image} alt={imageAlt} />
				</div>
			)
		}
	</div>
	<svg class="page-hero__edge" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true">
		<path d="M0 40V22c120-14 260 10 420 4s300-22 460-14 340 18 560 6v22z" fill="var(--paper)"></path>
	</svg>
</section>

<style>
	.page-hero {
		padding-block: clamp(56px, 8vw, 104px) clamp(72px, 9vw, 120px);
		position: relative;
		overflow: hidden;
	}
	.page-hero__inner {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}
	.has-image .page-hero__inner {
		grid-template-columns: 1fr;
	}
	@media (min-width: 900px) {
		.has-image .page-hero__inner {
			grid-template-columns: 1.25fr 0.9fr;
			gap: 4rem;
		}
	}
	.page-hero h1 {
		font-size: clamp(2.8rem, 6.4vw, 5rem);
		margin-bottom: 0.35em;
	}
	.page-hero h1 :global(em) {
		font-style: normal;
		color: var(--tan);
	}
	.page-hero__img {
		aspect-ratio: 4 / 4.4;
		max-height: 460px;
		transform: rotate(1.5deg);
		border: 6px solid var(--bone);
	}
	@media (max-width: 899px) {
		.page-hero__img {
			max-width: 420px;
			aspect-ratio: 4 / 3;
		}
	}
	.page-hero__edge {
		position: absolute;
		bottom: -1px;
		left: 0;
		width: 100%;
		height: 40px;
		display: block;
	}
</style>
