---
const creds = [
	{ src: '/images/logos/abtc.png', alt: 'ABTC Registered Animal Training Instructor', label: 'ABTC Registered Animal Training Instructor' },
	{ src: '/images/logos/tcbts.png', alt: 'The Canine Behaviour & Training Society', label: 'The Canine Behaviour & Training Society' },
	{ src: '/images/logos/uksd.jpg', alt: 'UK Sniffer Dogs instructor', label: 'UK Sniffer Dogs Instructor' },
	{ src: '/images/logos/tracking-dogs-uk.jpg', alt: 'Tracking Dogs UK', label: 'Tracking Dogs UK' },
];
---

<section class="creds" aria-label="Accreditations">
	<div class="container creds__inner">
		<p class="creds__label">Qualified &amp; accredited</p>
		<ul>
			{
				creds.map((c) => (
					<li title={c.label}>
						<img src={c.src} alt={c.alt} loading="lazy" />
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.creds {
		background: #fff;
		border-block: 1px solid var(--line);
		padding-block: 1.6rem;
	}
	.creds__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.2rem 2.5rem;
	}
	.creds__label {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem 2.8rem;
	}
	img {
		height: 58px;
		width: auto;
		filter: grayscale(1) contrast(1.05);
		opacity: 0.8;
		transition:
			filter 0.2s ease,
			opacity 0.2s ease;
	}
	li:hover img {
		filter: none;
		opacity: 1;
	}
	@media (max-width: 600px) {
		img {
			height: 46px;
		}
		ul {
			gap: 1.2rem 1.8rem;
		}
	}
</style>
