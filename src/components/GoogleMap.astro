---
import Icon from './Icon.astro';
import { mapQuery } from '../lib/consent';

// Google Map of the area. Google sets cookies, so the map only loads after the visitor accepts;
// until then a placeholder with an "Open in Google Maps" link is shown.
const embed = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=13&output=embed`;
const link = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
const mapHtml = `<iframe src="${embed}" title="Map of ${mapQuery.replace(/"/g, '')}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
---

{
	mapQuery && (
		<section class="map-section" aria-label="Map">
			<div class="container">
				<div class="map" data-consent-embed>
					<div class="map__placeholder topo" data-fallback>
						<span class="map__pin">
							<Icon name="pin" />
						</span>
						<h2>{mapQuery}</h2>
						<p>Accept cookies to view the map here.</p>
						<div class="btn-row">
							<button type="button" class="btn btn--light" data-consent-open>
								Show map
							</button>
							<a class="btn btn--ghost" href={link} target="_blank" rel="noopener">
								Open in Google Maps <Icon name="arrow" />
							</a>
						</div>
					</div>
					<div class="map__frame" data-widget hidden />
					<template data-widget-code set:html={mapHtml} />
				</div>
			</div>
		</section>
	)
}

<style>
	.map-section {
		padding-bottom: clamp(48px, 7vw, 88px);
	}
	.map {
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow);
		border: 1px solid var(--line);
		height: clamp(300px, 40vw, 420px);
		background: var(--navy);
	}
	.map__placeholder {
		height: 100%;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 0.6rem;
		padding: 1.5rem;
		text-align: center;
		color: var(--bone);
	}
	.map__placeholder[hidden],
	.map__frame[hidden] {
		display: none;
	}
	.map__pin {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		background: var(--signal);
		color: #fff;
		display: grid;
		place-items: center;
		box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.5);
	}
	.map__pin :global(svg) {
		width: 30px;
		height: 30px;
	}
	.map__placeholder h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		margin: 0.4rem 0 0;
	}
	.map__placeholder p {
		margin: 0 0 0.6rem;
		color: rgba(239, 234, 223, 0.75);
	}
	.map__placeholder .btn--ghost {
		color: var(--bone);
	}
	.map__frame,
	.map__frame :global(iframe) {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}
</style>
