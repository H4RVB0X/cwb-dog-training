---
interface Props {
	name: keyof typeof icons;
	class?: string;
}

const icons = {
	phone:
		'<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
	mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
	arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
	pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
	close: '<path d="M6 6l12 12M18 6 6 18"/>',
	facebook:
		'<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8.5a.5.5 0 0 1 .5-.5z"/>',
	instagram:
		'<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>',
	google:
		'<path d="M20.5 12.2c0-.6-.1-1.2-.2-1.7H12v3.3h4.8a4.1 4.1 0 0 1-1.8 2.7v2.2h2.9c1.7-1.6 2.6-3.9 2.6-6.5z"/><path d="M12 21c2.4 0 4.5-.8 5.9-2.2L15 16.5c-.8.5-1.8.9-3 .9-2.3 0-4.3-1.6-5-3.7H4v2.3A9 9 0 0 0 12 21z"/><path d="M7 13.7a5.4 5.4 0 0 1 0-3.4V8H4a9 9 0 0 0 0 8z"/><path d="M12 6.6c1.3 0 2.5.5 3.4 1.3L18 5.4A9 9 0 0 0 4 8l3 2.3c.7-2.1 2.7-3.7 5-3.7z"/>',
	paw: '<circle cx="7" cy="9" r="1.8"/><circle cx="11" cy="6" r="1.8"/><circle cx="15.5" cy="6.5" r="1.8"/><circle cx="18" cy="10.5" r="1.8"/><path d="M8.5 17.5c0-2.8 2-5.5 4.2-5.5s4.3 2.7 4.3 5.5c0 1.6-1.3 2.5-2.6 2.5-1 0-1.3-.6-1.7-.6s-.7.6-1.7.6c-1.3 0-2.5-.9-2.5-2.5z"/>',
	nose: '<path d="M4 12c0-4 3.6-7 8-7s8 3 8 7-3.6 7-8 7-8-3-8-7z"/><path d="M9 12.5c.8-.7 1.6-1 3-1s2.2.3 3 1M12 15v2"/>',
	whistle: '<circle cx="9" cy="14" r="5"/><path d="M12.5 10.5 21 6v4l-6.5 2.5"/><path d="M5 5l2 2"/>',
	home: '<path d="M4 11 12 4l8 7v9h-5v-6H9v6H4z"/>',
	check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
	star: '<path d="m12 3 2.8 5.8 6.2.9-4.5 4.4 1 6.3L12 17.5l-5.5 2.9 1-6.3L3 9.7l6.2-.9z" fill="currentColor"/>',
};

const { name, class: className } = Astro.props;
---

<svg
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={name === 'google' ? 0 : 2}
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	set:html={name === 'google' ? icons[name].replaceAll('<path', '<path fill="currentColor"') : icons[name]}
/>
