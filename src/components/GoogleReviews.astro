---
import settings from '../data/settings.json';

// Live Google reviews from a third-party widget (e.g. JustReview), pasted into the site settings.
// The widget only loads after the visitor accepts cookies. Until then (or if no widget is set up),
// the hand-picked reviews passed in as the slot are shown instead.
const code = settings.reviewsWidgetCode?.trim() ?? '';
---

{
	code ? (
		<div class="live-reviews" data-live-reviews>
			<div class="live-reviews__fallback" data-fallback>
				<slot />
				<p class="live-reviews__note">
					Showing a few of our reviews.{' '}
					<button type="button" class="live-reviews__allow" data-consent-open>
						Allow cookies to see the latest from Google
					</button>
				</p>
			</div>
			<div class="live-reviews__widget" data-widget hidden />
			<template data-widget-code set:html={code} />
		</div>
	) : (
		<slot />
	)
}

<script>
	function mount(root: HTMLElement) {
		if (root.dataset.mounted) return;
		const tpl = root.querySelector<HTMLTemplateElement>('template[data-widget-code]');
		const target = root.querySelector<HTMLElement>('[data-widget]');
		if (!tpl || !target) return;
		root.dataset.mounted = 'true';
		const frag = tpl.content.cloneNode(true) as DocumentFragment;
		// Scripts inside a <template> are inert; re-create them so they run
		frag.querySelectorAll('script').forEach((old) => {
			const s = document.createElement('script');
			for (const a of Array.from(old.attributes)) s.setAttribute(a.name, a.value);
			s.text = old.textContent ?? '';
			old.replaceWith(s);
		});
		target.append(frag);
		target.hidden = false;
		root.querySelector<HTMLElement>('[data-fallback]')!.hidden = true;
	}

	function update() {
		if (document.documentElement.dataset.cookieConsent !== 'granted') return;
		document.querySelectorAll<HTMLElement>('[data-live-reviews]').forEach(mount);
	}

	window.addEventListener('cwb:consent', update);
	update();
</script>

<style>
	.live-reviews__note {
		margin: 1.5rem 0 0;
		text-align: center;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.live-reviews__allow {
		font: inherit;
		font-weight: 600;
		color: var(--signal);
		background: none;
		border: 0;
		padding: 0;
		text-decoration: underline;
		text-underline-offset: 3px;
		cursor: pointer;
	}
	.live-reviews__widget[hidden],
	.live-reviews__fallback[hidden] {
		display: none;
	}
</style>
