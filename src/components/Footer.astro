---
import Icon from './Icon.astro';
import settings from '../data/settings.json';
import { getPosts } from '../lib/blog';

const hasPosts = (await getPosts()).length > 0;

const tel = settings.phone.replace(/\s/g, '');
const year = new Date().getFullYear();
---

<footer class="footer section--dark topo">
	<div class="container footer__grid">
		<div class="footer__brand">
			<a href="/" class="footer__logo" aria-label={`${settings.businessName}, home`}>
				<img src="/images/logos/cwb-logo-full.png" alt={settings.businessName} width="683" height="443" loading="lazy" />
			</a>
			<p>{settings.tagline}. 1-1 training, puppy foundations and UK Sniffer Dogs scent detection courses, based in {settings.location}.</p>
			<div class="social">
				<a href={settings.facebook} aria-label="Facebook" rel="noopener" target="_blank"><Icon name="facebook" /></a>
				<a href={settings.instagram} aria-label="Instagram" rel="noopener" target="_blank"><Icon name="instagram" /></a>
				<a href={settings.tiktok} aria-label="TikTok" rel="noopener" target="_blank"><Icon name="tiktok" /></a>
				<a href={settings.googleReviewsUrl} aria-label="Google reviews" rel="noopener" target="_blank"><Icon name="google" /></a>
			</div>
		</div>

		<div>
			<h3>Training</h3>
			<ul>
				<li><a href="/1-1-training/">1-1 Training</a></li>
				<li><a href="/courses/">Courses &amp; prices</a></li>
				<li><a href="/scentwork/">Scent detection</a></li>
				<li><a href="/1-1-training/#puppies">Puppies &amp; rescues</a></li>
				<li><a href="/betterdog/">BetterDog support</a></li>
			</ul>
		</div>

		<div>
			<h3>CWB</h3>
			<ul>
				<li><a href="/about/">About Chris</a></li>
				<li><a href="/reviews/">Reviews &amp; gallery</a></li>
				{hasPosts && <li><a href="/blog/">Blog</a></li>}
				<li><a href="/contact/">Contact</a></li>
				<li><a href="/contact/#faq">FAQs</a></li>
				<li><a href="/privacy/">Privacy &amp; legal</a></li>
			</ul>
		</div>

		<div>
			<h3>Get in touch</h3>
			<ul class="contact-list">
				<li><Icon name="phone" /><a href={`tel:${tel}`}>{settings.phone}</a></li>
				<li><Icon name="mail" /><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
				<li><Icon name="pin" /><span>{settings.location}, {settings.region}</span></li>
				<li><Icon name="clock" /><span>{settings.hours}</span></li>
			</ul>
		</div>
	</div>
	<div class="container footer__base">
		<span>© {year} {settings.businessName}. All rights reserved.{settings.legalNotice && ` ${settings.legalNotice}`} <a href="/privacy/">Privacy &amp; legal</a></span>
		<span>ABTC Registered Animal Training Instructor · UK Sniffer Dogs Instructor</span>
	</div>
</footer>

<style>
	.footer {
		background: var(--ink);
		color: var(--bone);
		padding-top: clamp(56px, 8vw, 96px);
	}
	.footer__grid {
		display: grid;
		gap: 2.5rem;
		grid-template-columns: 1fr;
	}
	@media (min-width: 640px) {
		.footer__grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (min-width: 980px) {
		.footer__grid {
			grid-template-columns: 1.5fr 0.8fr 0.8fr 1.3fr;
		}
	}
	.footer__logo {
		display: inline-block;
		background: #fff;
		border-radius: var(--radius-lg);
		padding: 14px 18px;
		margin-bottom: 1.2rem;
		transition: transform 0.2s ease;
	}
	.footer__logo:hover {
		transform: rotate(-1.5deg);
	}
	.footer__logo img {
		width: 190px;
		height: auto;
	}
	.footer__brand p {
		color: rgba(239, 234, 223, 0.7);
		max-width: 40ch;
	}
	.footer h3 {
		font-size: 1.15rem;
		letter-spacing: 0.12em;
		color: var(--tan);
		margin-bottom: 1rem;
	}
	.footer ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.6rem;
	}
	.footer a {
		text-decoration: none;
		color: rgba(239, 234, 223, 0.85);
	}
	.footer a:hover {
		color: var(--tan);
	}
	.contact-list li {
		display: grid;
		grid-template-columns: 20px 1fr;
		gap: 0.6rem;
		align-items: start;
		color: rgba(239, 234, 223, 0.85);
		overflow-wrap: anywhere;
	}
	.contact-list :global(svg) {
		width: 18px;
		height: 18px;
		margin-top: 4px;
		color: var(--tan);
	}
	.social {
		display: flex;
		gap: 0.6rem;
	}
	.social a {
		width: 44px;
		height: 44px;
		border: 1px solid rgba(239, 234, 223, 0.25);
		border-radius: 50%;
		display: grid;
		place-items: center;
		transition:
			background 0.15s ease,
			border-color 0.15s ease;
	}
	.social a:hover {
		background: var(--signal);
		border-color: var(--signal);
		color: #fff;
	}
	.social :global(svg) {
		width: 20px;
		height: 20px;
	}
	.footer__base {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.8rem;
		margin-top: 3.5rem;
		padding-block: 1.5rem;
		border-top: 1px solid rgba(239, 234, 223, 0.12);
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.04em;
		color: rgba(239, 234, 223, 0.55);
	}
</style>
