---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Credentials from '../components/Credentials.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';

import timeline from '../data/timeline.json';

const entries = timeline.entries.filter((t) => t.title?.trim());
---

<Layout
	title="About Chris"
	description="Meet Chris, the trainer behind CWB Dog Training in Wall Heath, Kingswinford. A lifetime with Labradors, police dog puppy fostering and service dog charity work."
>
	<PageHero
		eyebrow="About CWB"
		title="Every dog <em>teaches</em> you something."
		intro="If I could go back years and tell myself one thing when I started, it would be that every dog that comes into your life will teach you something."
		image="/images/chris.jpg"
		imageAlt="Chris, founder of CWB Dog Training, smiling in a navy CWB hoodie"
	/>

	<section class="section">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">The story so far</span>
				<h2>From Panda to <span class="accent">CWB.</span></h2>
			</div>

			<ol class="timeline">
				{
					entries.map((t, i) => (
						<li class="timeline__item reveal" class:list={{ 'is-flip': i % 2 === 1 }}>
							{t.image ? (
								<div class="timeline__img frame">
									<img src={t.image} alt={t.imageAlt} loading="lazy" />
								</div>
							) : (
								<div class="timeline__img timeline__img--empty topo" aria-hidden="true">
									<Icon name="paw" />
									<span>{t.when}</span>
								</div>
							)}
							<div class="timeline__dot" aria-hidden="true" />
							<div class="timeline__text">
								<span class="tag tag--olive">{t.when}</span>
								<h3>{t.title}</h3>
								<p>{t.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section section--olive topo">
		<div class="container still-learning reveal">
			<span class="eyebrow">Still learning</span>
			<p class="still-learning__q">
				“The more I work with dogs, the more I see the individuals: their personalities, and how they make me think and
				adjust what I do to get my message across.”
			</p>
			<p class="still-learning__a">
				Hearing from clients that they enjoy their time with their dog, or that they’ve passed my details on to a friend or
				relative, tells me I’m headed in the right direction.
			</p>
		</div>
	</section>

	<Credentials />
	<CtaBand title="Let’s meet your dog" />
</Layout>

<style>
	.timeline {
		list-style: none;
		margin: 0;
		padding: 0;
		position: relative;
		display: grid;
		gap: clamp(40px, 6vw, 80px);
	}
	.timeline::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 2px;
		background: repeating-linear-gradient(to bottom, var(--khaki) 0 8px, transparent 8px 16px);
	}
	.timeline__item {
		display: grid;
		grid-template-columns: 1fr 60px 1fr;
		align-items: center;
	}
	.timeline__img {
		aspect-ratio: 4 / 3;
		max-height: 340px;
	}
	.timeline__img--empty {
		border-radius: var(--radius-lg);
		background: var(--navy);
		color: var(--bone);
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 0.6rem;
		width: 100%;
		box-shadow: var(--shadow);
	}
	.timeline__img--empty :global(svg) {
		width: 56px;
		height: 56px;
		color: var(--tan);
	}
	.timeline__img--empty span {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.8rem, 3.4vw, 2.6rem);
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	.timeline__dot {
		justify-self: center;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--signal);
		border: 5px solid var(--paper);
		box-shadow: 0 0 0 2px var(--signal);
		position: relative;
		z-index: 1;
	}
	.timeline__text h3 {
		font-size: clamp(1.8rem, 3vw, 2.4rem);
		margin: 0.6rem 0 0.4rem;
	}
	.timeline__text p {
		color: var(--muted);
		margin: 0;
	}
	.is-flip .timeline__img {
		order: 3;
	}
	.is-flip .timeline__text {
		order: 1;
		text-align: right;
	}
	.is-flip .timeline__dot {
		order: 2;
	}

	@media (max-width: 820px) {
		.timeline::before {
			left: 11px;
		}
		.timeline__item,
		.is-flip.timeline__item {
			grid-template-columns: 24px 1fr;
			column-gap: 1.2rem;
			row-gap: 1rem;
		}
		.timeline__dot,
		.is-flip .timeline__dot {
			order: 0;
			grid-row: 1;
			grid-column: 1;
			align-self: start;
			margin-top: 6px;
		}
		.timeline__img,
		.is-flip .timeline__img {
			order: 0;
			grid-column: 2;
			grid-row: 2;
			max-height: 260px;
		}
		.timeline__text,
		.is-flip .timeline__text {
			order: 0;
			grid-column: 2;
			grid-row: 1;
			text-align: left;
		}
	}

	.still-learning {
		max-width: 900px;
	}
	.still-learning__q {
		font-family: var(--font-display);
		font-weight: 700;
		text-transform: uppercase;
		font-size: clamp(1.8rem, 3.8vw, 3rem);
		line-height: 1.05;
	}
	.still-learning__a {
		font-size: 1.15rem;
		color: rgba(239, 234, 223, 0.85);
		max-width: 60ch;
	}
</style>
