---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, formatDate } from '../../lib/blog';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post, more: posts.filter((p) => p.id !== post.id).slice(0, 3) } }));
}

const { post, more } = Astro.props;
const d = post.data;
const { Content } = await render(post);
---

<Layout title={d.title} description={d.summary ?? d.title} image={d.image}>
	<article>
		<header class="post-hero section--dark topo">
			<div class="container post-hero__inner">
				<a class="back" href="/blog/"><Icon name="arrow" /> All posts</a>
				<time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
				<h1>{d.title}</h1>
				{d.summary && <p class="lede">{d.summary}</p>}
			</div>
		</header>

		<div class="container post-wrap" class:list={{ 'has-cover': !!d.image }}>
			{
				d.image && (
					<div class="post-cover frame">
						<img src={d.image} alt={d.imageAlt} />
					</div>
				)
			}
			<div class="post-body">
				<Content />
			</div>
			<p class="signoff">Chris, CWB Dog Training</p>
		</div>
	</article>

	{
		more.length > 0 && (
			<section class="section section--bone topo">
				<div class="container">
					<div class="section-head">
						<span class="eyebrow">Keep reading</span>
						<h2>More from the blog</h2>
					</div>
					<div class="grid grid--3">
						{more.map((p) => (
							<PostCard post={p} />
						))}
					</div>
				</div>
			</section>
		)
	}

	<CtaBand />
</Layout>

<style>
	.post-hero {
		padding-block: clamp(48px, 7vw, 88px) clamp(56px, 7vw, 88px);
	}
	.post-hero__inner {
		max-width: 860px;
	}
	.has-cover {
		/* pull the cover photo up over the dark header */
		--overlap: clamp(80px, 11vw, 150px);
	}
	.post-hero:has(+ .has-cover) {
		padding-bottom: calc(clamp(56px, 7vw, 88px) + clamp(80px, 11vw, 150px));
	}
	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--tan);
		margin-bottom: 1.6rem;
	}
	.back :global(svg) {
		width: 18px;
		height: 18px;
		transform: rotate(180deg);
	}
	time {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--tan);
		margin-bottom: 0.8rem;
	}
	h1 {
		font-size: clamp(2.4rem, 5.6vw, 4.2rem);
		margin-bottom: 0.35em;
	}

	.post-wrap {
		max-width: 860px;
		padding-top: 3rem;
		padding-bottom: clamp(56px, 8vw, 96px);
	}
	.post-wrap.has-cover {
		padding-top: 0;
	}
	.post-cover {
		margin-top: calc(var(--overlap) * -1);
		aspect-ratio: 16 / 9;
		border: 6px solid var(--paper);
		margin-bottom: 2.5rem;
	}
	.post-cover img {
		object-position: 50% 30%;
	}
	.post-body {
		font-size: 1.15rem;
		line-height: 1.7;
	}
	.post-body :global(h2) {
		font-size: clamp(1.7rem, 3vw, 2.2rem);
		margin: 2rem 0 0.6rem;
	}
	.post-body :global(h3) {
		margin: 1.6rem 0 0.5rem;
	}
	.post-body :global(a) {
		color: var(--signal);
		font-weight: 600;
		text-underline-offset: 3px;
	}
	.post-body :global(ul),
	.post-body :global(ol) {
		padding-left: 1.3rem;
		margin: 0 0 1em;
	}
	.post-body :global(li) {
		margin-bottom: 0.4rem;
	}
	.post-body :global(li::marker) {
		color: var(--signal);
	}
	.post-body :global(img) {
		border-radius: var(--radius-lg);
		margin: 1.5rem 0;
	}
	.post-body :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.4rem 0 0.4rem 1.2rem;
		border-left: 4px solid var(--tan);
		font-size: 1.25rem;
		font-weight: 500;
	}
	.signoff {
		margin-top: 2.5rem;
		padding-top: 1.2rem;
		border-top: 1px dashed var(--line);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.2rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--navy);
	}
</style>
