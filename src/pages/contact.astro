---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import settings from '../data/settings.json';

const courses = (await getCollection('courses', (c) => !c.data.hidden)).sort((a, b) => a.data.order - b.data.order);
const options = [
	{ value: '1-1-training', label: '1-1 Training / initial assessment' },
	{ value: 'home-visit', label: 'Pre-puppy or new dog home visit' },
	...courses.map((c) => ({ value: c.id, label: `${c.data.title} (${c.data.price})` })),
	{ value: 'other', label: 'Something else' },
];
const tel = settings.phone.replace(/\s/g, '');
---

<Layout
	title="Contact & Booking"
	description={`Get in touch with CWB Dog Training in ${settings.location}. Call ${settings.phone}, email or send an enquiry to book a course or 1-1 assessment.`}
>
	<PageHero
		eyebrow="Contact"
		title="Drop me a <em>line.</em>"
		intro="Tell me a little about your dog and what you’d like to work on, and I’ll get back to you to arrange the next step."
	/>

	<section class="section contact">
		<div class="container contact__grid">
			<aside class="contact__info">
				<a class="info-card" href={`tel:${tel}`}>
					<span class="info-card__icon"><Icon name="phone" /></span>
					<span><small>Call or text</small><strong>{settings.phone}</strong></span>
				</a>
				<a class="info-card" href={`https://wa.me/${settings.whatsapp}`} target="_blank" rel="noopener">
					<span class="info-card__icon"><Icon name="whatsapp" /></span>
					<span><small>WhatsApp</small><strong>Send a message</strong></span>
				</a>
				<a class="info-card" href={`mailto:${settings.email}`}>
					<span class="info-card__icon"><Icon name="mail" /></span>
					<span><small>Email</small><strong class="email">{settings.email}</strong></span>
				</a>
				<a
					class="info-card"
					href="https://www.google.com/maps/search/?api=1&query=CWB+Dog+Training+Wall+Heath+Kingswinford"
					target="_blank"
					rel="noopener"
				>
					<span class="info-card__icon"><Icon name="pin" /></span>
					<span><small>Based in · get directions</small><strong>{settings.location}</strong></span>
				</a>
				<div class="info-card">
					<span class="info-card__icon"><Icon name="clock" /></span>
					<span><small>Hours</small><strong>{settings.hours}</strong></span>
				</div>
				<div class="social-row">
					<a href={settings.facebook} target="_blank" rel="noopener"><Icon name="facebook" /> Facebook</a>
					<a href={settings.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram</a>
					<a href={settings.tiktok} target="_blank" rel="noopener"><Icon name="tiktok" /> TikTok</a>
				</div>
			</aside>

			<form id="enquiry" class="form card" data-form data-key={settings.web3formsKey} data-email={settings.email} action="https://api.web3forms.com/submit" method="POST" novalidate>
				<input type="hidden" name="access_key" value={settings.web3formsKey} />
				<input type="hidden" name="subject" value="New enquiry from cwbdogtraining.co.uk" />
				<input type="hidden" name="from_name" value="CWB Dog Training website" />
				<input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />

				<h2>Send an enquiry</h2>

				<div class="form__row">
					<label class="field">
						<span>Your name</span>
						<input name="name" autocomplete="name" />
					</label>
					<label class="field">
						<span>Contact number <em>*</em></span>
						<input name="phone" type="tel" autocomplete="tel" required />
					</label>
				</div>
				<label class="field">
					<span>Email <em>*</em></span>
					<input name="email" type="email" autocomplete="email" required />
				</label>
				<div class="form__row">
					<label class="field">
						<span>Dog’s name &amp; breed</span>
						<input name="dog" placeholder="e.g. Pinto, black Labrador" />
					</label>
					<label class="field">
						<span>Dog’s age</span>
						<input name="dog_age" placeholder="e.g. 14 weeks" />
					</label>
				</div>
				<label class="field">
					<span>I’m interested in</span>
					<select name="interested_in" data-course-select>
						<option value="">Choose an option…</option>
						{options.map((o) => <option value={o.label} data-id={o.value}>{o.label}</option>)}
					</select>
				</label>
				<label class="field">
					<span>Message</span>
					<textarea name="message" rows="5" placeholder="Tell me about your dog and what you’d like help with" data-message></textarea>
				</label>

				<button class="btn form__submit" type="submit">Send enquiry <Icon name="arrow" /></button>
				<p class="form__status" role="status" aria-live="polite" data-status></p>
				<p class="form__note">Your details are only used to reply to your enquiry. <a href="/privacy/">Privacy</a></p>
			</form>
		</div>
	</section>

	<Faq />
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-form]')!;
	const status = form.querySelector<HTMLElement>('[data-status]')!;
	const select = form.querySelector<HTMLSelectElement>('[data-course-select]')!;
	const message = form.querySelector<HTMLTextAreaElement>('[data-message]')!;

	// Pre-select the course from ?course=... links across the site
	const params = new URLSearchParams(location.search);
	const course = params.get('course');
	if (course) {
		const opt = [...select.options].find((o) => o.dataset.id === course);
		if (opt) select.value = opt.value;
	}
	const pkg = params.get('package');
	if (pkg) message.value = `I’m interested in the ${pkg} package.\n\n`;

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		status.className = 'form__status';

		const invalid = [...form.querySelectorAll<HTMLInputElement>('[required]')].find((el) => !el.checkValidity());
		if (invalid) {
			status.textContent = 'Please add your email and contact number so I can get back to you.';
			status.classList.add('is-error');
			invalid.focus();
			return;
		}

		const data = new FormData(form);

		// No form key configured yet: fall back to opening the visitor's email app
		if (!form.dataset.key) {
			const lines = [...data.entries()]
				.filter(([k, v]) => !['access_key', 'subject', 'from_name', 'botcheck'].includes(k) && v)
				.map(([k, v]) => `${k.replace('_', ' ')}: ${v}`);
			location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Website enquiry')}&body=${encodeURIComponent(lines.join('\n'))}`;
			return;
		}

		const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
		btn.disabled = true;
		status.textContent = 'Sending…';
		try {
			const res = await fetch(form.action, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: data,
			});
			const json = await res.json();
			if (!res.ok || !json.success) throw new Error(json.message);
			form.reset();
			status.textContent = 'Thanks! Your enquiry is on its way. I’ll be in touch soon.';
			status.classList.add('is-ok');
		} catch {
			status.textContent = 'Sorry, something went wrong. Please call or email instead.';
			status.classList.add('is-error');
		} finally {
			btn.disabled = false;
		}
	});
</script>

<style>
	.contact {
		padding-top: clamp(40px, 6vw, 72px);
	}
	.contact__grid {
		display: grid;
		gap: 2.5rem;
		align-items: start;
	}
	@media (min-width: 960px) {
		.contact__grid {
			grid-template-columns: 0.85fr 1.3fr;
			gap: 4rem;
		}
	}
	.contact__info {
		display: grid;
		gap: 0.9rem;
	}
	.info-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.1rem 1.2rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: #fff;
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
		min-width: 0;
	}
	a.info-card:hover {
		border-color: var(--signal);
		transform: translateX(4px);
	}
	.info-card__icon {
		width: 48px;
		height: 48px;
		flex: none;
		border-radius: 50%;
		background: var(--navy);
		color: var(--tan);
		display: grid;
		place-items: center;
	}
	.info-card__icon :global(svg) {
		width: 22px;
		height: 22px;
	}
	.info-card small {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.info-card strong {
		font-family: var(--font-display);
		font-size: 1.45rem;
		letter-spacing: 0.02em;
		line-height: 1.15;
	}
	.info-card strong.email {
		font-size: 1.1rem;
		overflow-wrap: anywhere;
	}
	.info-card > span:last-child {
		min-width: 0;
	}
	.social-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.2rem;
		margin-top: 0.6rem;
	}
	.social-row a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--navy);
		font-weight: 600;
		text-underline-offset: 3px;
	}
	.social-row :global(svg) {
		width: 20px;
		height: 20px;
		color: var(--signal);
	}

	.form {
		padding: clamp(1.4rem, 4vw, 2.5rem);
		display: grid;
		gap: 1.1rem;
		border-top: 6px solid var(--signal);
	}
	.form h2 {
		font-size: clamp(1.8rem, 3vw, 2.4rem);
		margin: 0 0 0.3rem;
	}
	.form__row {
		display: grid;
		gap: 1.1rem;
	}
	@media (min-width: 620px) {
		.form__row {
			grid-template-columns: 1fr 1fr;
		}
	}
	.field {
		display: grid;
		gap: 0.4rem;
	}
	.field > span {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--navy);
	}
	.field em {
		color: var(--signal);
		font-style: normal;
	}
	.field input,
	.field select,
	.field textarea {
		width: 100%;
		font: inherit;
		font-size: 1rem;
		padding: 0.8rem 0.9rem;
		min-height: 50px;
		border: 1.5px solid rgba(20, 29, 36, 0.22);
		border-radius: var(--radius);
		background: var(--paper);
		color: var(--ink);
		transition:
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.field textarea {
		resize: vertical;
	}
	.field input:focus,
	.field select:focus,
	.field textarea:focus {
		outline: none;
		border-color: var(--olive);
		background: #fff;
		box-shadow: 0 0 0 3px rgba(72, 85, 58, 0.18);
	}
	.form__submit {
		justify-self: start;
		margin-top: 0.4rem;
	}
	.form__submit:disabled {
		opacity: 0.6;
		cursor: wait;
	}
	.form__status {
		margin: 0;
		font-weight: 500;
	}
	.form__status:empty {
		display: none;
	}
	.form__status.is-ok {
		color: var(--olive);
	}
	.form__status.is-error {
		color: var(--signal);
	}
	.form__note {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
	}
</style>
