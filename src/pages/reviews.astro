---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import settings from '../data/settings.json';
import gallery from '../data/gallery.json';

const reviews = (await getCollection('reviews')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
	title="Reviews & Gallery"
	description={`CWB Dog Training is rated ${settings.rating} from ${settings.reviewCount} Google reviews. Read what clients say and meet some of the dogs we’ve trained.`}
>
	<PageHero
		eyebrow="Reviews & gallery"
		title={`${settings.rating} stars. <em>${settings.reviewCount} reviews.</em>`}
		intro="Don’t just take my word for it. Here’s what owners say about training with CWB, and a few of the brilliant dogs I’ve had the pleasure of working with."
	>
		<div class="btn-row">
			<a class="btn" href={settings.googleReviewsUrl} target="_blank" rel="noopener"><Icon name="google" /> All reviews on Google</a>
			<a class="btn btn--ghost" href="#gallery">Gallery</a>
		</div>
	</PageHero>

	<section class="section">
		<div class="container">
			<div class="grid grid--3 reviews">
				{reviews.map((r) => <ReviewCard review={r} />)}
				<a class="review-cta reveal" href={settings.googleReviewsUrl} target="_blank" rel="noopener">
					<span class="review-cta__score">{settings.rating}</span>
					<span class="stars">★★★★★</span>
					<strong>Read all {settings.reviewCount} reviews</strong>
					<span>on Google <Icon name="arrow" /></span>
				</a>
			</div>
		</div>
	</section>

	<section class="section section--bone topo" id="gallery">
		<div class="container">
			<div class="section-head">
				<span class="eyebrow">Gallery</span>
				<h2>Good dogs, all of them</h2>
			</div>
			<ul class="gallery">
				{
					gallery.photos.map((p) => (
						<li class="reveal">
							<button type="button" class="gallery__btn" data-full={p.image} data-alt={p.alt}>
								<img src={p.image} alt={p.alt} loading="lazy" />
							</button>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<dialog class="lightbox" data-lightbox>
		<form method="dialog"><button class="lightbox__close" aria-label="Close"><Icon name="close" /></button></form>
		<img src="" alt="" />
	</dialog>

	<CtaBand title="Could your dog be next?" />
</Layout>

<script>
	const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
	const img = dlg.querySelector('img')!;
	document.querySelectorAll<HTMLButtonElement>('.gallery__btn').forEach((b) =>
		b.addEventListener('click', () => {
			img.src = b.dataset.full!;
			img.alt = b.dataset.alt!;
			dlg.showModal();
		}),
	);
	dlg.addEventListener('click', (e) => {
		if (e.target === dlg) dlg.close();
	});
</script>

<style>
	.review-cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 0.4rem;
		padding: 2rem;
		border-radius: var(--radius-lg);
		background: var(--navy);
		color: var(--bone);
		text-decoration: none;
		transition: transform 0.2s ease;
	}
	.review-cta:hover {
		transform: translateY(-4px);
	}
	.review-cta__score {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 5rem;
		line-height: 1;
	}
	.review-cta .stars {
		font-size: 1.4rem;
	}
	.review-cta strong {
		font-family: var(--font-display);
		font-size: 1.5rem;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		margin-top: 0.6rem;
	}
	.review-cta span:last-child {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--tan);
	}
	.review-cta :global(svg) {
		width: 18px;
		height: 18px;
	}

	.gallery {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 2 160px;
		column-gap: 14px;
	}
	@media (min-width: 900px) {
		.gallery {
			columns: 4;
		}
	}
	.gallery li {
		break-inside: avoid;
		margin-bottom: 14px;
	}
	.gallery__btn {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		border-radius: var(--radius-lg);
		overflow: hidden;
		cursor: zoom-in;
		background: var(--khaki);
	}
	.gallery__btn img {
		width: 100%;
		transition:
			transform 0.5s ease,
			opacity 0.2s ease;
	}
	.gallery__btn:hover img {
		transform: scale(1.04);
	}

	.lightbox {
		padding: 0;
		border: 0;
		background: transparent;
		max-width: min(92vw, 1000px);
		max-height: 90vh;
		overflow: visible;
	}
	.lightbox::backdrop {
		background: rgba(20, 29, 36, 0.88);
	}
	.lightbox img {
		max-height: 86vh;
		width: auto;
		border-radius: var(--radius-lg);
		border: 6px solid var(--bone);
	}
	.lightbox__close {
		position: absolute;
		top: -18px;
		right: -18px;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 0;
		background: var(--signal);
		color: #fff;
		display: grid;
		place-items: center;
		cursor: pointer;
		z-index: 1;
	}
	.lightbox__close :global(svg) {
		width: 22px;
		height: 22px;
	}
	@media (max-width: 600px) {
		.lightbox__close {
			top: 6px;
			right: 6px;
		}
	}
</style>
